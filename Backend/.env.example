# AGRI-SWAP Backend Environment Configuration Template
# Copy this file to .env and configure for your local environment or cloud provider

# Node.js Server Port (Default: 5000)
PORT=5000

# Environment Mode: 'development' or 'production'
# In production, internal error trace details are masked from API clients
NODE_ENV=development

# Allowed CORS Origins (Comma-separated list of approved frontend domains)
# Example: https://agri-swap.vercel.app,https://my-domain.com
# If left blank, allows all origins in development and automatically permits localhost/127.0.0.1
CORS_ORIGIN=

# Dedicated ResNet50 Vision Inference Microservice URL
# Point this to your standalone vision service instance to decouple heavy TensorFlow memory from the Node backend.
# In production on Render: Set this to your vision web service URL (e.g. https://agri-swap-vision.onrender.com)
# In local development: Defaults to http://127.0.0.1:5001
VISION_INFERENCE_URL=http://127.0.0.1:5001

# Inference Request Timeout in milliseconds (Default: 35000 ms)
# 35 seconds accommodates free-tier cold-boot spin-up on Render.
VISION_TIMEOUT_MS=35000

# Python Executable Command
# Windows default: python | Linux cloud containers: python3 (or path to venv, e.g. /opt/venv/bin/python)
PYTHON_CMD=

# MongoDB Connection URI (Optional)
# If left blank or unset, AGRI-SWAP operates in local offline mode
# using DuckDB/SQLite/Parquet datasets for all Price Analytics, LSTM, and Food Substitution.
MONGO_URI=

# Custom DNS Override (Optional, default: false)
# Set to true only if experiencing ISP-level DNS resolution issues with MongoDB SRV
CUSTOM_DNS=false
